# config/proxmox-nodes/pve.kiwik.org.env — bare-metal Proxmox node (Minisforum MS-A2)
#
# Plain KEY=value lines only; read by scripts/proxmox-node/*.sh via config::load
# (scripts/lib/config.sh). No secrets in this file — passwords, keys, and
# certificates never belong here (see scripts/README.md).
#
# Values here must match inventory/hardware.md, inventory/networks.md, and
# inventory/ip-plan.md — update both together.

# Management network (already configured at install time)
MGMT_IFACE="nic0"
MGMT_BRIDGE="vmbr0"
MGMT_CIDR="192.168.88.101/24"
MGMT_GATEWAY="192.168.88.1"

# General VM network (no node IP; bridges guest traffic only)
VM_IFACE="nic1"
VM_BRIDGE="vmbr1"
VM_BRIDGE_COMMENT="General VM network"

# Local Proxmox storage (all content types: images, containers, ISOs,
# templates, backups, snippets), on a new partition in the OS NVMe's free
# space — see docs/design/04-storage.md and scripts/proxmox-node/20-storage.sh.
LOCAL_DATA_STORAGE_ID="local-data"
LOCAL_DATA_MOUNTPOINT="/mnt/local-data"
LOCAL_DATA_STORAGE_PATH="/mnt/local-data/pve-storage"
LOCAL_DATA_CONTENT="images,rootdir,vztmpl,iso,backup,snippets"
LOCAL_DATA_MIN_GIB="10"
OS_STORAGES="local local-btrfs"
# LOCAL_DATA_DISK="/dev/nvme0n1"  # uncomment to override OS-disk detection

# Time synchronisation (chrony) — see docs/design/02-proxmox-install.md and
# scripts/proxmox-node/05-proxmox-install.sh. Only these servers are used.
# An empty array () reverts the node to the OS default chrony configuration.
NTP_SERVERS=("0.pool.ntp.org" "1.pool.ntp.org" "2.pool.ntp.org" "3.pool.ntp.org")

# Time zone (IANA name) — see docs/design/02-proxmox-install.md. An empty
# value "" reverts to the zone saved in /etc/timezone.orig before the first
# change.
TIMEZONE="Europe/Copenhagen"

# APT repositories — see docs/design/02-proxmox-install.md. The enterprise
# repositories (subscription required) are always disabled, never deleted.
# PVE_REPOSITORY: "no-subscription", or "" to restore the stock file saved in
# /etc/apt/sources.list.orig before the first change.
# CEPH_REPOSITORY: "disabled", "no-subscription", or "" to restore the stock
# file likewise.
PVE_REPOSITORY="no-subscription"
CEPH_REPOSITORY="disabled"

# Node resource priority — see docs/design/09-resource-management.md and
# scripts/proxmox-node/25-resource-priority.sh. The node's own processes
# (system.slice, user.slice) get a higher weight than guests; weights only
# matter under contention. An empty value reverts that setting.
# HOST_CPU_WEIGHT / HOST_IO_WEIGHT: 1-10000 (default 100). BFQ scales the I/O
# weight to 1-1000, so 10000 gives BFQ weight 1000.
# HOST_MEMORY_LOW: memory of system.slice protected from reclaim.
# IO_SCHEDULER: scheduler of the OS disk; "bfq" is needed for I/O weights.
HOST_CPU_WEIGHT="1000"
HOST_IO_WEIGHT="10000"
HOST_MEMORY_LOW="4G"
IO_SCHEDULER="bfq"
