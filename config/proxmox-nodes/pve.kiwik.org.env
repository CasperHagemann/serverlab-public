# config/proxmox-nodes/pve.kiwik.org.env — bare-metal Proxmox node (Minisforum MS-A2)
#
# Plain KEY=value lines only; read by scripts/proxmox-node/*.sh via config::load
# (scripts/lib/config.sh). No secrets in this file — passwords, keys, and
# certificates never belong here (see scripts/README.md).
#
# Values here are specific to this node.
# Site networks: inventory/ip-plan.md. Hardware: inventory/hardware.md.

# Management network (already configured at install time)
NET_MGMT_IFACE="nic0"
NET_MGMT_BRIDGE="vmbr0"
NET_MGMT_CIDR="192.168.88.101/24"
NET_MGMT_GATEWAY="192.168.88.1"

# VM trunk network (tagged only; no node IP; bridges guest traffic only)
# NET_VM_BRIDGE_VLAN_AWARE: 1 = VLAN aware checkbox on, 0 = off.
# NET_VM_BRIDGE_VIDS: VLAN IDs of the bridge (IDs/ranges, space-separated,
# within 2-4094). "" means 2-4094, the same as a blank field in the GUI.
NET_VM_IFACE="nic1"
NET_VM_BRIDGE="vmbr1"
NET_VM_BRIDGE_COMMENT="Guest Trunk"
NET_VM_BRIDGE_VLAN_AWARE="1"
NET_VM_BRIDGE_VIDS="2-4094"

# Local Proxmox storage (all content types: images, containers, ISOs,
# templates, backups, snippets), on a new partition in the OS NVMe's free
# space — see docs/design/storage.md and scripts/proxmox-node/storage.sh.
STORAGE_ID="local-data"
STORAGE_MOUNTPOINT="/mnt/local-data"
STORAGE_PATH="/mnt/local-data/pve-storage"
STORAGE_CONTENT="images,rootdir,vztmpl,iso,backup,snippets"
STORAGE_MIN_GIB="10"
STORAGE_OS_DISABLE="local local-btrfs"
# STORAGE_DISK="/dev/nvme0n1"  # uncomment to override OS-disk detection

# Time synchronisation (chrony) — see docs/design/base-system.md and
# scripts/proxmox-node/base-system.sh. Only these servers are used.
# An empty array () reverts the node to the OS default chrony configuration.
BASE_NTP_SERVERS=("0.pool.ntp.org" "1.pool.ntp.org" "2.pool.ntp.org" "3.pool.ntp.org")

# Time zone (IANA name) — see docs/design/base-system.md. An empty
# value "" reverts to the zone saved in /etc/timezone.orig before the first
# change.
BASE_TIMEZONE="Europe/Copenhagen"

# APT repositories — see docs/design/base-system.md. The enterprise
# repositories (subscription required) are always disabled, never deleted.
# BASE_PVE_REPOSITORY: "no-subscription", or "" to restore the stock file
# saved in /etc/apt/sources.list.orig before the first change.
# BASE_CEPH_REPOSITORY: "disabled", "no-subscription", or "" to restore the
# stock file likewise.
BASE_PVE_REPOSITORY="no-subscription"
BASE_CEPH_REPOSITORY="disabled"

# Node resource priority — see docs/design/resource-management.md and
# scripts/proxmox-node/resource-management.sh. The node's own processes
# (system.slice, user.slice) get a higher weight than guests; weights only
# matter under contention. An empty value reverts that setting.
# RESOURCE_CPU_WEIGHT / RESOURCE_IO_WEIGHT: 1-10000 (default 100). BFQ
# scales the I/O weight to 1-1000, so 10000 gives BFQ weight 1000.
# RESOURCE_MEMORY_LOW: memory of system.slice protected from reclaim.
# RESOURCE_IO_SCHEDULER: scheduler of the OS disk; "bfq" is needed for I/O
# weights.
RESOURCE_CPU_WEIGHT="1000"
RESOURCE_IO_WEIGHT="10000"
RESOURCE_MEMORY_LOW="4G"
RESOURCE_IO_SCHEDULER="bfq"
