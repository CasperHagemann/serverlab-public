#!/usr/bin/env bash
#
# .githooks/pre-commit — runs before every commit, staged files only.
#
# Installed via scripts/control-node/install-hooks.sh (core.hooksPath). Never modifies
# files — if it fails, run ./scripts/control-node/check.sh to fix, then re-stage and
# re-commit. Bypass with `git commit --no-verify` if truly needed.

set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "${repo_root}"

exec ./scripts/control-node/check.sh --check
